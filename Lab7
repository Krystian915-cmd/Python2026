import math
import random
from tkinter import *
from tkinter.messagebox import showerror, showinfo

# =============================================================================
# ZADANIE 1: Kalkulator z obsługą błędów i Radiobuttonami
# =============================================================================

def oblicz_kalkulator():
    try:
        x = float(e1.get())
        y = float(e2.get())
        op = var_op.get()

        if op == 1:
            wynik = x + y
        elif op == 2:
            wynik = x - y
        elif op == 3:
            wynik = x * y
        elif op == 4:
            if y == 0:
                raise ZeroDivisionError("Dzielenie przez zero!")
            wynik = x / y
        else:
            showerror("Błąd", "Wybierz działanie!")
            return

        showinfo("Wynik", f"Wynik: {wynik}")
    except ValueError:
        showerror("Błąd", "Wpisz poprawne liczby!")
    except ZeroDivisionError as e:
        showerror("Błąd matematyczny", str(e))

# =============================================================================
# ZADANIE 2: Kalkulator raty kredytu z kolorami emocji
# =============================================================================

def oblicz_rate():
    try:
        K = float(ent_k.get())  # Kwota
        n = int(ent_n.get())    # Liczba miesięcy
        p = 5.0                 # Stopa 5%
        q = 1 + p/100
        
        # Wzór: rata = (K * q^n * (1-q)) / (1 - q^n)
        rata = (K * (q**n) * (1-q)) / (1 - (q**n))
        rata = round(rata, 2)
        
        if rata < 500:
            kolor = "green"  # Ulga
        elif rata < 1500:
            kolor = "orange" # Niepokój
        else:
            kolor = "red"    # Przerażenie
            
        lbl_rata.config(text=f"Rata: {rata} zł", fg=kolor)
    except:
        showerror("Błąd", "Wprowadź poprawne dane kredytowe!")

# =============================================================================
# ZADANIE 3: Ankieta świąteczna (Checkbuttony)
# =============================================================================

def wyslij_ankiete():
    prezenty = []
    if c1.get(): prezenty.append("AGD")
    if c2.get(): prezenty.append("Kosmetyki")
    if c3.get(): prezenty.append("Odzież")
    
    wynik = ", ".join(prezenty) if prezenty else "brak"
    showinfo("Ankieta", f"Wybrane prezenty: {wynik}")

