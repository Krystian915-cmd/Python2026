def zadanie_9():
    katalog = "DaneTekstowe"
    if not os.path.exists(katalog):
        os.makedirs(katalog)
    
    pliki = ["Tekst1ID_ABC.txt", "Tekst2ID_405.txt", "Tekst3ID_607.txt", "Tekst4ID_ABC.txt", "Tekst5ID_DEF.txt"]
    tresc = "Python jest super. To jest przykładowe zdanie numer jeden. Każdy plik ma ten sam tekst."
    
    for p in pliki:
        with open(os.path.join(katalog, p), 'w', encoding='utf-8') as f:
            f.write(tresc)

    def analiza_podstawowa(folder):
        nazwy = os.listdir(folder)
        print("Wszystkie pliki:", nazwy)
        
        for n in nazwy:
            # Sprawdzanie czy kończy się na 'ABC' (przed rozszerzeniem)
            if n.split('.')[0].endswith('ABC'):
                with open(os.path.join(folder, n), 'r', encoding='utf-8') as f:
                    slowa = f.read().split()
                    dlugie_slowa = [s for s in slowa if len(s) >= 3]
                    print(f"Plik {n} ma {len(dlugie_slowa)} słów >= 3 litery.")
        return nazwy

    def analiza_rozszerzona(folder):
        pliki = analiza_podstawowa(folder)
        z_zerem = [p for p in pliki if '0' in p]
        print(f"Liczba plików z '0' w nazwie: {len(z_zerem)}")
        
        for p in pliki:
            if '0' not in p:
                with open(os.path.join(folder, p), 'r', encoding='utf-8') as f:
                    count = len(f.read().split())
                    print(f"Plik {p} (bez zera) ma {count} słów.")

    analiza_rozszerzona(katalog)

