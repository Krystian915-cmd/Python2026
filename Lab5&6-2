def zmien_i_listuj(sciezka):
    try:
        os.chdir(sciezka)
        print(f"Obecny katalog: {os.getcwd()}")
        print("Zawartość:", os.listdir('.'))
    except FileNotFoundError:
        print("Błąd: Nie znaleziono wskazanej ścieżki.")

