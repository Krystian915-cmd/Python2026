def zadanie_7():
    liczba = 123456789
    # 'q' oznacza long long (8 bajtów), 'i' to standardowy int (4 bajty)
    # Dla tak dużej liczby 'i' wystarczy, ale użyjemy 'q' dla pewności
    spakowane = struct.pack('q', liczba)
    print(f"Spakowane binarne: {spakowane}")
    
    rozpakowane = struct.unpack('q', spakowane)
    print(f"Rozpakowana liczba: {rozpakowane[0]}")

