# --- Task 6 ---
# Obliczanie symbolu Newtona: n! / (k! * (n-k)!)
silnia = lambda n: functools.reduce(operator.mul, range(1, n + 1), 1)
newton = lambda n, k: silnia(n) // (silnia(k) * silnia(n - k))

n_val = int(input("Podaj n: "))
k_val = int(input("Podaj k: "))
print("Zadanie 6 (Symbol Newtona):", newton(n_val, k_val))

