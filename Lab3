# --- Task 11 ---
poziom_pro = lambda n: "*" * n
pion_pro = lambda n: "*\n" * n
rysuj_e = lambda size: f"{poziom_pro(size)}\n{pion_pro(1)}{poziom_pro(size-1)}\n{pion_pro(1)}{poziom_pro(size)}"
rysuj_l = lambda size: f"{pion_pro(size)}{poziom_pro(size)}"

wybor = input("Wybierz E lub L: ").upper()
print(rysuj_e(5) if wybor == "E" else rysuj_l(5) if wybor == "L" else "Blad")
