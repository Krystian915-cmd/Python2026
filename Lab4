# --- Zadanie 11 (MapReduce / Dziel i rządź) ---
jezyki = ['python', 'java', 'C++', 'C#', 'Ruby', 'JavaScript']
list_prog = [random.choice(jezyki) for _ in range(10000)]

def licz_jezyki(dane):
    # Mapowanie na krotki (klucz, 1)
    mapowane = list(map(lambda x: (x, 1), dane))
    
    # Redukcja/Agregacja
    wynik = {}
    for jezyk, licznik in mapowane:
        wynik[jezyk] = wynik.get(jezyk, 0) + licznik
    return wynik

print("Zadanie 11 (Zliczanie):", licz_jezyki(list_prog))
